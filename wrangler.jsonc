{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "youtube-feeder-worker",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/.well-known/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "youtube-feeder",
			"database_id": "670b33d8-43e4-417a-b9c2-c692ed88ca05",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// Every 2 hours UTC so missed WebSub pings are repaired within the SLA.
		"crons": ["0 */2 * * *"]
	},
	"vars": {
		"MOCK_DATA": "false",
		"PUBLIC_ORIGIN": "https://youtube-feeder-worker.ike-j-rebout.workers.dev",
		"YOUTUBE_DAILY_QUOTA": "10000",
		"YOUTUBE_QUOTA_WARN": "8000",
		"YOUTUBE_RECONCILE_RESERVE": "2000",
		"YOUTUBE_BACKFILL_CUTOFF": "7500",
		"DISCOVER_SEARCH_PROVIDER": "brave",
		"DISCOVER_PROVIDER_STRATEGY_VERSION": "v1",
		"BRAVE_USER_DAILY_SOFT_CAP": "100",
		"BRAVE_GLOBAL_DAILY_SOFT_CAP": "750",
		"DISCOVER_BRAVE_MAX_PAGES_PER_REQUEST": "3",
		"DISCOVER_BRAVE_TYPED_RESULT_LIMIT": "42"
	}
}
